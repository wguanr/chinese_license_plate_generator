<!DOCTYPE html>
<html lang="zh-CN">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>车牌生成器 - 统一管理平台</title>
    <style>
        * { margin: 0; padding: 0; box-sizing: border-box; }
        
        :root {
            --primary: #4a90d9;
            --primary-dark: #357abd;
            --success: #52c41a;
            --warning: #faad14;
            --danger: #ff4d4f;
            --bg-dark: #1a1a2e;
            --bg-card: #16213e;
            --bg-hover: #1f3460;
            --text-primary: #ffffff;
            --text-secondary: #a0aec0;
            --border: #2d3748;
        }
        
        body {
            font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
            background: var(--bg-dark);
            color: var(--text-primary);
            min-height: 100vh;
            overflow-x: hidden;
        }
        
        /* 顶部导航栏 */
        .top-nav {
            position: fixed;
            top: 0;
            left: 0;
            right: 0;
            height: 60px;
            background: var(--bg-card);
            border-bottom: 1px solid var(--border);
            display: flex;
            align-items: center;
            padding: 0 24px;
            z-index: 1000;
        }
        
        .logo {
            display: flex;
            align-items: center;
            gap: 12px;
            font-size: 20px;
            font-weight: 600;
        }
        
        .logo-icon { font-size: 28px; }
        
        .nav-tabs {
            display: flex;
            gap: 8px;
            margin-left: 48px;
            flex: 1;
        }
        
        .nav-tab {
            padding: 8px 20px;
            border-radius: 8px;
            cursor: pointer;
            transition: all 0.3s;
            font-size: 14px;
            background: transparent;
            border: none;
            color: var(--text-secondary);
        }
        
        .nav-tab:hover {
            background: var(--bg-hover);
            color: var(--text-primary);
        }
        
        .nav-tab.active {
            background: var(--primary);
            color: white;
        }
        
        /* 主内容区 */
        .main-container {
            margin-top: 60px;
            padding: 24px;
            min-height: calc(100vh - 60px);
        }
        
        .tab-content {
            display: none;
        }
        
        .tab-content.active {
            display: block;
            animation: fadeIn 0.3s;
        }
        
        @keyframes fadeIn {
            from { opacity: 0; transform: translateY(10px); }
            to { opacity: 1; transform: translateY(0); }
        }
        
        /* 卡片样式 */
        .card {
            background: var(--bg-card);
            border-radius: 12px;
            border: 1px solid var(--border);
            padding: 24px;
            margin-bottom: 24px;
        }
        
        .card-header {
            font-size: 18px;
            font-weight: 600;
            margin-bottom: 16px;
            display: flex;
            align-items: center;
            gap: 8px;
        }
        
        /* 按钮样式 */
        .btn {
            padding: 10px 20px;
            border-radius: 8px;
            border: none;
            cursor: pointer;
            font-size: 14px;
            transition: all 0.3s;
            display: inline-flex;
            align-items: center;
            gap: 8px;
        }
        
        .btn-primary {
            background: var(--primary);
            color: white;
        }
        
        .btn-primary:hover {
            background: var(--primary-dark);
        }
        
        .btn-success {
            background: var(--success);
            color: white;
        }
        
        .btn-ghost {
            background: transparent;
            border: 1px solid var(--border);
            color: var(--text-primary);
        }
        
        .btn-ghost:hover {
            background: var(--bg-hover);
        }
        
        /* 表单样式 */
        .form-group {
            margin-bottom: 20px;
        }
        
        .form-label {
            display: block;
            margin-bottom: 8px;
            color: var(--text-secondary);
            font-size: 14px;
        }
        
        .form-control {
            width: 100%;
            padding: 10px 16px;
            background: var(--bg-dark);
            border: 1px solid var(--border);
            border-radius: 8px;
            color: var(--text-primary);
            font-size: 14px;
        }
        
        .form-control:focus {
            outline: none;
            border-color: var(--primary);
        }
        
        /* 网格布局 */
        .grid {
            display: grid;
            gap: 24px;
        }
        
        .grid-2 { grid-template-columns: repeat(2, 1fr); }
        .grid-3 { grid-template-columns: repeat(3, 1fr); }
        
        /* 预览区域 */
        .preview-area {
            min-height: 300px;
            background: var(--bg-dark);
            border-radius: 8px;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 24px;
        }
        
        .preview-image {
            max-width: 100%;
            max-height: 400px;
            border-radius: 8px;
            box-shadow: 0 4px 20px rgba(0, 0, 0, 0.3);
        }
        
        .preview-placeholder {
            text-align: center;
            color: var(--text-secondary);
        }
        
        .preview-placeholder .icon {
            font-size: 48px;
            margin-bottom: 16px;
            opacity: 0.5;
        }
        
        /* 加载动画 */
        .loading-spinner {
            width: 40px;
            height: 40px;
            border: 4px solid var(--border);
            border-top-color: var(--primary);
            border-radius: 50%;
            animation: spin 1s linear infinite;
        }
        
        @keyframes spin {
            to { transform: rotate(360deg); }
        }
        
        /* 3D查看器样式 */
        #viewer3d-canvas {
            width: 100%;
            height: 600px;
            background: var(--bg-dark);
            border-radius: 8px;
        }
        
        .model-list {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(200px, 1fr));
            gap: 16px;
        }
        
        .model-item {
            background: var(--bg-dark);
            border: 2px solid var(--border);
            border-radius: 8px;
            padding: 12px;
            cursor: pointer;
            transition: all 0.3s;
        }
        
        .model-item:hover {
            border-color: var(--primary);
            transform: translateY(-2px);
        }
        
        .model-item.selected {
            border-color: var(--success);
            background: var(--bg-hover);
        }
        
        .model-thumbnail {
            width: 100%;
            height: 120px;
            object-fit: cover;
            border-radius: 4px;
            margin-bottom: 8px;
        }
        
        .model-info {
            font-size: 12px;
            color: var(--text-secondary);
        }
        
        /* 响应式 */
        @media (max-width: 768px) {
            .nav-tabs { margin-left: 16px; }
            .grid-2, .grid-3 { grid-template-columns: 1fr; }
            .main-container { padding: 16px; }
        }
    </style>
</head>
<body>
    <!-- 顶部导航 -->
    <nav class="top-nav">
        <div class="logo">
            <span class="logo-icon">🚗</span>
            <span>车牌生成器</span>
        </div>
        <div class="nav-tabs">
            <button class="nav-tab active" onclick="switchTab('generate')">🎨 生成</button>
            <button class="nav-tab" onclick="switchTab('viewer3d')">🎬 3D查看</button>
            <button class="nav-tab" onclick="switchTab('gallery')">🖼️ 图库</button>
            <button class="nav-tab" onclick="switchTab('assets')">📦 资产</button>
        </div>
    </nav>
    
    <!-- 主内容 -->
    <div class="main-container">
        <!-- 生成页面 -->
        <div id="tab-generate" class="tab-content active">
            <div class="grid grid-2">
                <!-- 配置区 -->
                <div>
                    <div class="card">
                        <div class="card-header">⚙️ 生成配置</div>
                        <div class="form-group">
                            <label class="form-label">车牌类型</label>
                            <select class="form-control" id="plateType">
                                <option value="blue">蓝牌（小型车）</option>
                                <option value="yellow">黄牌（大型车）</option>
                                <option value="green_car">绿牌（新能源小型车）</option>
                                <option value="green_truck">绿牌（新能源大型车）</option>
                                <option value="white">白牌（军警）</option>
                                <option value="black">黑牌（外籍）</option>
                            </select>
                        </div>
                        <div class="form-group">
                            <label class="form-label">噪声等级</label>
                            <select class="form-control" id="noisePreset">
                                <option value="clean">干净（无噪声）</option>
                                <option value="light">轻度</option>
                                <option value="medium" selected>中度</option>
                                <option value="heavy">重度</option>
                            </select>
                        </div>
                        <div class="form-group">
                            <label class="form-label">生成数量</label>
                            <input type="number" class="form-control" id="batchCount" value="10" min="1" max="100">
                        </div>
                        <div style="display: flex; gap: 12px;">
                            <button class="btn btn-ghost" onclick="generatePreview()">👁️ 预览</button>
                            <button class="btn btn-primary" style="flex: 1;" onclick="startBatchGenerate()">🚀 开始生成</button>
                        </div>
                    </div>
                    
                    <!-- 任务列表 -->
                    <div class="card">
                        <div class="card-header">📋 生成任务</div>
                        <div id="taskList">
                            <div class="preview-placeholder">
                                <div class="icon">📭</div>
                                <p>暂无任务</p>
                            </div>
                        </div>
                    </div>
                </div>
                
                <!-- 预览区 -->
                <div>
                    <div class="card">
                        <div class="card-header">👁️ 实时预览</div>
                        <div class="preview-area" id="previewArea">
                            <div class="preview-placeholder">
                                <div class="icon">🖼️</div>
                                <p>点击"预览"按钮生成预览图</p>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        
        <!-- 3D查看器页面 -->
        <div id="tab-viewer3d" class="tab-content">
            <div class="grid grid-2">
                <!-- 模型列表 -->
                <div>
                    <div class="card">
                        <div class="card-header">📦 模型列表</div>
                        <div class="model-list" id="modelList">
                            <div class="preview-placeholder">
                                <div class="icon">📦</div>
                                <p>加载中...</p>
                            </div>
                        </div>
                    </div>
                </div>
                
                <!-- 3D视图 -->
                <div>
                    <div class="card">
                        <div class="card-header">🎬 3D视图</div>
                        <div id="viewer3d-container"></div>
                    </div>
                </div>
            </div>
        </div>
        
        <!-- 图库页面 -->
        <div id="tab-gallery" class="tab-content">
            <div class="card">
                <div class="card-header">🖼️ 图库</div>
                <div id="galleryGrid">
                    <div class="preview-placeholder">
                        <div class="icon">🖼️</div>
                        <p>加载中...</p>
                    </div>
                </div>
            </div>
        </div>
        
        <!-- 资产管理页面 -->
        <div id="tab-assets" class="tab-content">
            <div class="card">
                <div class="card-header">📦 资产管理</div>
                <div id="assetsTable">
                    <div class="preview-placeholder">
                        <div class="icon">📦</div>
                        <p>加载中...</p>
                    </div>
                </div>
            </div>
        </div>
    </div>
    
    <script src="https://cdn.jsdelivr.net/npm/three@0.160.0/build/three.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/three@0.160.0/examples/js/loaders/GLTFLoader.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/three@0.160.0/examples/js/controls/OrbitControls.js"></script>
    
    <script>
        // 标签页切换
        function switchTab(tabName) {
            // 更新导航
            document.querySelectorAll('.nav-tab').forEach(tab => {
                tab.classList.remove('active');
            });
            event.target.classList.add('active');
            
            // 更新内容
            document.querySelectorAll('.tab-content').forEach(content => {
                content.classList.remove('active');
            });
            document.getElementById(`tab-${tabName}`).classList.add('active');
            
            // 加载对应数据
            if (tabName === 'viewer3d') {
                loadModels();
            } else if (tabName === 'gallery') {
                loadGallery();
            } else if (tabName === 'assets') {
                loadAssets();
            }
        }
        
        // 生成预览
        async function generatePreview() {
            const previewArea = document.getElementById('previewArea');
            previewArea.innerHTML = '<div class="loading-spinner"></div>';
            
            try {
                const response = await fetch('/api/generate/preview', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({
                        plate_type: document.getElementById('plateType').value,
                        noise_preset: document.getElementById('noisePreset').value
                    })
                });
                
                const data = await response.json();
                
                if (data.success) {
                    previewArea.innerHTML = `
                        <img src="${data.image_url}?t=${Date.now()}" class="preview-image" alt="预览">
                    `;
                } else {
                    previewArea.innerHTML = `
                        <div class="preview-placeholder">
                            <div class="icon">❌</div>
                            <p>${data.error || '生成失败'}</p>
                        </div>
                    `;
                }
            } catch (error) {
                previewArea.innerHTML = `
                    <div class="preview-placeholder">
                        <div class="icon">❌</div>
                        <p>请求失败: ${error.message}</p>
                    </div>
                `;
            }
        }
        
        // 批量生成
        async function startBatchGenerate() {
            try {
                const response = await fetch('/api/generate/batch', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({
                        plate_type: document.getElementById('plateType').value,
                        noise_preset: document.getElementById('noisePreset').value,
                        count: parseInt(document.getElementById('batchCount').value)
                    })
                });
                
                const data = await response.json();
                
                if (data.success) {
                    alert(`✅ 任务创建成功！任务ID: ${data.task_id}`);
                    loadTasks();
                } else {
                    alert(`❌ 创建失败: ${data.error}`);
                }
            } catch (error) {
                alert(`❌ 请求失败: ${error.message}`);
            }
        }
        
        // 加载任务列表
        async function loadTasks() {
            try {
                const response = await fetch('/api/generate/tasks');
                const data = await response.json();
                const taskList = document.getElementById('taskList');
                
                if (!data.tasks || data.tasks.length === 0) {
                    taskList.innerHTML = `
                        <div class="preview-placeholder">
                            <div class="icon">📭</div>
                            <p>暂无任务</p>
                        </div>
                    `;
                    return;
                }
                
                taskList.innerHTML = data.tasks.map(task => `
                    <div class="card" style="margin-bottom: 12px;">
                        <div style="display: flex; justify-content: space-between; align-items: center;">
                            <div>
                                <strong>${task.task_id}</strong>
                                <span style="color: var(--text-secondary); margin-left: 8px;">
                                    ${task.config.plate_type} | ${task.config.noise_preset}
                                </span>
                            </div>
                            <div>
                                <span style="color: ${task.status === 'completed' ? 'var(--success)' : 'var(--warning)'}">
                                    ${task.status === 'completed' ? '✅ 完成' : '⏳ 进行中'}
                                </span>
                                <span style="margin-left: 8px;">${task.progress}/${task.total}</span>
                            </div>
                        </div>
                    </div>
                `).join('');
            } catch (error) {
                console.error('加载任务失败:', error);
            }
        }
        
        // 加载3D模型列表
        async function loadModels() {
            try {
                const response = await fetch('/api/models3d');
                const data = await response.json();
                const modelList = document.getElementById('modelList');
                
                if (!data.models || data.models.length === 0) {
                    modelList.innerHTML = `
                        <div class="preview-placeholder">
                            <div class="icon">📦</div>
                            <p>暂无模型</p>
                        </div>
                    `;
                    return;
                }
                
                modelList.innerHTML = data.models.map(model => `
                    <div class="model-item" onclick="loadModel('${model.glb_url}')">
                        <img src="${model.thumbnail}" class="model-thumbnail" alt="${model.plate_number}">
                        <div class="model-info">
                            <div><strong>${model.plate_number}</strong></div>
                            <div>${model.plate_type} | ${model.noise_preset}</div>
                        </div>
                    </div>
                `).join('');
                
                // 初始化3D查看器
                if (!window.viewer3dInitialized) {
                    init3DViewer();
                    window.viewer3dInitialized = true;
                }
            } catch (error) {
                console.error('加载模型失败:', error);
            }
        }
        
        // 初始化3D查看器
        let scene, camera, renderer, controls;
        
        function init3DViewer() {
            const container = document.getElementById('viewer3d-container');
            container.innerHTML = '<canvas id="viewer3d-canvas"></canvas>';
            
            scene = new THREE.Scene();
            scene.background = new THREE.Color(0x1a1a2e);
            
            camera = new THREE.PerspectiveCamera(50, 1, 0.1, 1000);
            camera.position.set(0, 0.3, 1);
            
            renderer = new THREE.WebGLRenderer({ canvas: document.getElementById('viewer3d-canvas'), antialias: true });
            renderer.setSize(600, 600);
            
            const ambientLight = new THREE.AmbientLight(0xffffff, 0.5);
            scene.add(ambientLight);
            
            const directionalLight = new THREE.DirectionalLight(0xffffff, 0.8);
            directionalLight.position.set(5, 5, 5);
            scene.add(directionalLight);
            
            controls = new THREE.OrbitControls(camera, renderer.domElement);
            controls.enableDamping = true;
            
            animate();
        }
        
        function animate() {
            requestAnimationFrame(animate);
            controls.update();
            renderer.render(scene, camera);
        }
        
        // 加载3D模型
        function loadModel(url) {
            const loader = new THREE.GLTFLoader();
            
            // 清除现有模型
            scene.children.forEach(child => {
                if (child.type === 'Group') {
                    scene.remove(child);
                }
            });
            
            loader.load(url, (gltf) => {
                scene.add(gltf.scene);
                console.log('模型加载成功:', url);
            }, undefined, (error) => {
                console.error('模型加载失败:', error);
            });
        }
        
        // 加载图库
        async function loadGallery() {
            const galleryGrid = document.getElementById('galleryGrid');
            galleryGrid.innerHTML = '<div class="preview-placeholder"><div class="icon">🖼️</div><p>功能开发中...</p></div>';
        }
        
        // 加载资产
        async function loadAssets() {
            const assetsTable = document.getElementById('assetsTable');
            assetsTable.innerHTML = '<div class="preview-placeholder"><div class="icon">📦</div><p>功能开发中...</p></div>';
        }
        
        // 定时刷新任务列表
        setInterval(loadTasks, 3000);
        loadTasks();
    </script>
</body>
</html>
