## 5. 使用模式和最佳实践

### 基础材质创建模式

```python
from core import MaterialParameters, MaterialParametersBuilder

# 方式1: 直接创建
material = MaterialParameters(
    albedo_texture_path="textures/plate_albedo.png",
    noise_texture_path="textures/noise.png",
    roughness=0.2,
    metallic=0.8
)

# 方式2: 建造者模式
builder = MaterialParametersBuilder()
material = (builder
    .set_albedo_texture("textures/albedo.png")
    .set_noise_texture("textures/noise.png")
    .set_material_properties(roughness=0.3, metallic=0.7)
    .set_base_color(0.9, 0.9, 0.9)
    .build())
```

### 变体生成模式

```python
from core import ParameterDistributor, DistributionType, MaterialVariantGenerator, VariantStrategy

# 使用参数分布器
distributor = ParameterDistributor(DistributionType.NORMAL)
variants = distributor.generate_variants(base_material, count=20)

# 使用变体生成器
generator = MaterialVariantGenerator(VariantStrategy.HYBRID)
themed_variants = generator.generate_themed_variants(
    base_material, theme="metal", count=15
)
```

### 异常处理模式

```python
from core import PCGSystemError, ValidationError, DependencyError

try:
    # 材质创建逻辑
    material = create_complex_material()
    variants = generate_variants(material)
except ValidationError as e:
    print(f"参数验证失败: {e.field} = {e.value}")
except DependencyError as e:
    print(f"依赖 {e.dependency_name} 不可用，使用基础功能")
except PCGSystemError as e:
    print(f"系统错误 [{e.error_code}]: {e.message}")
```

### 系统初始化模式

```python
from core import initialize_pcg_system

# 初始化系统
result = initialize_pcg_system(enable_usd=False, verbose=True)

if result['success']:
    # 系统就绪，开始使用
    from core import MaterialParameters, ParameterDistributor
    
    # 正常使用流程
    material = MaterialParameters(...)
    distributor = ParameterDistributor()
    variants = distributor.generate_variants(material, count=10)
else:
    print("系统初始化失败:")
    for error in result['errors']:
        print(f"  - {error}")
```

### 自定义算法扩展

```python
from core import BasePCGAlgorithm, MaterialParameters
from typing import List

class CustomAlgorithm(BasePCGAlgorithm):
    """自定义算法示例"""
    
    def __init__(self):
        super().__init__("CustomAlgorithm", "1.0.0")
        self.set_parameter("variation_factor", 0.1)
    
    def generate_variants(self, base_params: MaterialParameters, 
                         count: int, **kwargs) -> List[MaterialParameters]:
        """实现自定义变体生成逻辑"""
        variants = []
        variation = self.get_parameter("variation_factor", 0.1)
        
        for i in range(count):
            # 生成变体参数
            new_roughness = max(0.0, min(1.0, 
                base_params.roughness + self.get_random_value(-variation, variation)))
            new_metallic = max(0.0, min(1.0,
                base_params.metallic + self.get_random_value(-variation, variation)))
            
            # 创建变体
            variant = MaterialParameters(
                albedo_texture_path=base_params.albedo_texture_path,
                noise_texture_path=base_params.noise_texture_path,
                roughness=new_roughness,
                metallic=new_metallic,
                noise_tensity=base_params.noise_tensity,
                base_color=base_params.base_color
            )
            variants.append(variant)
        
        return variants
    
    def validate_parameters(self, parameters: MaterialParameters) -> bool:
        """验证参数"""
        try:
            # MaterialParameters 自带验证
            return True
        except Exception:
            return False

# 使用自定义算法
algorithm = CustomAlgorithm()
algorithm.set_parameter("variation_factor", 0.2)
variants = algorithm.generate_variants(base_material, count=5)
```

