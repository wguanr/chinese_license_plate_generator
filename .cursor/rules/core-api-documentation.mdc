    print("✅ 核心模块可用")

# 查看警告信息
for warning in result['warnings']:
    print(f"⚠️  {warning}")
```

### 异常诊断

```python
import traceback
from core import PCGSystemError

try:
    # 可能出错的操作
    risky_operation()
except PCGSystemError as e:
    print(f"PCG系统错误: {e}")
    print(f"错误码: {e.error_code}")
    print(f"详细信息: {e.details}")
